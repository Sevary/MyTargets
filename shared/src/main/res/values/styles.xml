<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme using MaterialComponents Bridge to keep older AppCompat attrs working -->
    <style name="AppBaseTheme" parent="Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <!-- Keep your existing color definitions or add them if missing -->
        <item name="colorPrimary">@color/md_blue_500</item>
        <item name="colorPrimaryVariant">@color/md_blue_700</item>
        <item name="colorOnPrimary">@color/md_white_1000</item>

        <item name="colorSecondary">@color/md_deep_orange_500</item>
        <item name="colorSecondaryVariant">@color/md_deep_orange_700</item>
        <item name="colorOnSecondary">@color/md_white_1000</item>

        <!--
        <item name="android:statusBarColor">@color/md_blue_700</item>
        <item name="android:navigationBarColor">@color/md_blue_700</item>
        -->

        <!-- Helpful defaults for Material widgets like Slider -->
        <item name="colorSurface">@color/md_white_1000</item>
        <item name="colorOnSurface">@color/md_blue_grey_900</item>
    </style>

    <!-- Material variant theme so shared resources can reference AppTheme.Material -->
    <style name="AppTheme.Material" parent="AppBaseTheme" />

    <style name="AppTheme" parent="AppBaseTheme"/>

    <!-- Toolbar variant if you had one -->
    <style name="AppTheme.CustomToolbar" parent="AppBaseTheme">
        <!-- Toolbar-specific overrides if needed -->
    </style>

    <style name="AppTheme.Material.Toolbar" parent="AppTheme.Material" />

    <!-- (Optional) explicit Slider style -->
    <style name="Widget.MyTargets.Slider" parent="Widget.MaterialComponents.Slider"/>
</resources>
